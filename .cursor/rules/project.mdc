## 6. 微前端配置规范

### 6.1 微应用配置 (src/config/microApps.ts)
- **强制规范**：微应用配置必须严格遵循如下规范：
```typescript
/**
 * 微应用配置接口
 */
export interface MicroApp {
  name: string /** 微应用名称 */;
  entry: string /** 微应用入口地址 */;
  container: string /** 微应用挂载容器 */;
  activeRule: string /** 微应用激活规则 */;
  props?: Record<string, unknown> /** 传递给微应用的属性 */;
}

/**
 * 微应用列表配置
 */
export const microApps: MicroApp[] = [
  {
    name: 'vue-app',
    entry: '//localhost:3001',
    container: '#subapp-viewport',
    activeRule: '/vue-app',
    props: {
      routerBase: '/vue-app',
    },
  },
  {
    name: 'react-app',
    entry: '//localhost:3002',
    container: '#subapp-viewport',
    activeRule: '/react-app',
